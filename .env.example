APP_NAME=Autonomous Job Agent
DATABASE_PATH=./data/agent.db
LOG_LEVEL=INFO
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
LLM_ENABLED=true
LLM_MAX_REQUESTS_PER_MINUTE=3
LLM_MAX_REQUESTS_PER_DAY=60
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=25
LLM_CACHE_TTL_SECONDS=604800
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOB_COUNTRY=in
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
SMTP_STARTTLS=true

SCHEDULER_ENABLED=false
DISCOVERY_INTERVAL_HOURS=24
DAILY_REPORT_HOUR=18
DEFAULT_JOB_QUERY=agentic AI engineer OR generative AI engineer OR GenAI developer
DEFAULT_JOB_LOCATION=India
LLM_RANK_TOP_N=10
